# Copy to .env.vultr, keep private. Supply the Serverless Inference subscription key.
VULTR_INFERENCE_API_KEY=
# Choose an exact tool-capable model ID available in your Vultr subscription.
VULTR_INFERENCE_MODEL=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Deployment target only; never sent to the sandbox or inference service.
VULTR_VM_HOST=
VULTR_VM_USER=
VULTR_VM_SSH_KEY=
# Optional for future instance provisioning; not required for an existing VM.
VULTR_API_KEY=
